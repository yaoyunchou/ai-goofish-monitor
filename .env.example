################################################################################
# 🚀 1. 必填核心配置 (AI 模型)
# 支持 openai（OpenAI 兼容接口）与 cursor（Cursor SDK）两种提供方。
################################################################################

# AI 提供方：openai | cursor
AI_PROVIDER=openai

# --- OpenAI 兼容接口（AI_PROVIDER=openai 时使用）---
# 模型的 API Key。
OPENAI_API_KEY=sk-...

# 模型的 API 接口地址。
# 这里需要填写服务商提供的、兼容 OpenAI 格式的 API 地址。
# 例如: https://api.openai.com/v1/ 或国内大模型厂商提供的地址。
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1/

# 使用的模型名称。
# 注意：该模型必须支持图片分析功能 (Vision)。
OPENAI_MODEL_NAME=XiaomiMiMo/MiMo-V2-Flash

# --- Cursor SDK（AI_PROVIDER=cursor 时使用）---
# 在 Cursor Dashboard -> API Keys 创建
CURSOR_API_KEY=

# Cursor 模型 ID，例如 composer-2.5
CURSOR_MODEL_NAME=composer-2.5

# 运行环境：local（本机 Cursor）| cloud（Cursor Cloud）；留空时在 Cloud Agent 内自动 cloud
CURSOR_RUNTIME=

# local 模式下的工作目录
CURSOR_LOCAL_CWD=.

# cloud 模式可选：逗号分隔的 GitHub 仓库 URL
CURSOR_CLOUD_REPOS=


################################################################################
# 🖥️ 2. Web 管理界面配置
# 用于访问控制台，保护你的配置不被他人篡改。
################################################################################

# 服务运行端口 (默认 8000)
SERVER_PORT=8000

# 管理员账号与密码 (默认 admin / admin123)
WEB_USERNAME=admin
WEB_PASSWORD=admin123


################################################################################
# 🗄️ 5. 数据库（仅 PostgreSQL / Supabase）
# 详见 docs/database-supabase-integration.md
# 历史 SQLite 可选：python3 -m scripts.migrate_sqlite_to_postgres --source data/app.sqlite3
################################################################################

DATABASE_URL=postgresql+asyncpg://postgres.wkhatdhgohkpsqkytotz:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# SUPABASE_URL=https://wkhatdhgohkpsqkytotz.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=


################################################################################
# 🕷️ 3. 爬虫基础设置
# 控制浏览器的运行行为。
################################################################################

# 爬虫是否以无头模式运行 (默认 true)。
# 注意：使用 Docker 部署时必须设为 true。
RUN_HEADLESS=true

# 开发调试：在 Web「采集控制台」页面内嵌卖家订阅实时日志（默认 false，调试完改回 false）
SELLER_SUBSCRIPTION_CONSOLE_LOG=false

# 是否使用 Edge 浏览器内核 (默认 false, 即使用 Chrome)。
# 仅影响本地浏览器通道；Docker 镜像未内置 Edge，容器内会固定使用 Chromium。
LOGIN_IS_EDGE=false

# 是否开启自动转换：将电脑端链接转换为手机端链接 (建议开启)
PCURL_TO_MOBILE=true


################################################################################
# 🛠️ 4. AI 策略与兼容性 (可选)
# 如果你发现 AI 分析不准确或报错，请尝试调整此处。
################################################################################

# AI 调试模式 (默认 false)。开启后控制台会打印详细的 AI 分析日志。
AI_DEBUG_MODE=false

# (可选) 为 AI 请求配置 HTTP/S 代理。支持 http 和 socks5。
# 例如: http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
PROXY_URL=""

# 是否启用 enable_thinking 参数 (某些模型如 DeepSeek 可能需要，默认 false)
ENABLE_THINKING=false

# 是否启用 response_format (默认 true)。
# 豆包模型等不支持 json_object 格式的需设为 false；Gemini/GPT 等建议设为 true。
ENABLE_RESPONSE_FORMAT=true


################################################################################
# 📢 5. 消息推送配置 (可选)
# 只要配置其中一个即可收到通知。
################################################################################

# --- ntfy (推荐) ---
NTFY_TOPIC_URL=

# --- Bark (iOS 推荐) ---
# 例如: https://api.day.app/your_key
BARK_URL=

# --- 企业微信机器人 ---
WX_BOT_URL=

# --- Telegram 机器人 ---
# 获取 Token 找 @BotFather，获取 Chat ID 找 @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 可选：Telegram Bot API 反代地址，默认 https://api.telegram.org
TELEGRAM_API_BASE_URL=

# --- Gotify ---
GOTIFY_URL=
GOTIFY_TOKEN=

# --- 通用 Webhook ---
WEBHOOK_URL=
WEBHOOK_METHOD="POST"
WEBHOOK_CONTENT_TYPE="JSON"
WEBHOOK_HEADERS='{"X-API-TOKEN":"your-secret-token"}'
WEBHOOK_QUERY_PARAMETERS='{"title":"{{title}}","content":"{{content}}"}'
WEBHOOK_BODY='{"title":"{{title}}","content":"{{content}}"}'


################################################################################
# 🛡️ 6. 高级功能 (可选)
################################################################################

# --- 任务失败保护 ---
# 当任务持续失败(如 Cookie 失效)时，自动暂停避免风控。
TASK_FAILURE_THRESHOLD=3
TASK_FAILURE_PAUSE_SECONDS=86400
# 状态文件路径 (默认 logs/task-failure-guard.json)
TASK_FAILURE_GUARD_PATH=

# --- 任务运行日志清理 ---
# 启动时自动清理 logs/*.log 中超过保留天数的历史日志（默认 7 天）
TASK_LOG_RETENTION_DAYS=7

# --- 商品监控健康度自动停用 ---
# 卖家订阅的商品若一整周内「浏览」与「想要」都没有有效增长，自动停止监控（不再采其详情）。
# 判定周期：Asia/Shanghai 自然周（周一 ~ 周日），默认每周一 09:00 判定。
# ⚠️ 建议先保持 DRY_RUN=true 观察 1~2 周，确认阈值合适后再开启真实停用。
# 总开关：false 时完全不执行停用（默认 false）。需与 MONITOR_DRY_RUN 配合。
MONITOR_AUTO_DISABLE_ENABLED=false
# 影子模式：true 时只记录与通知，不实际停用（默认 true，安全）
MONITOR_DRY_RUN=true
# 达标线（OR 口径）：浏览增长 ≥ 此值 或 想要增长 ≥ 此值 → 保留；两者都低才停用
# 注意：浏览增长门槛已定稿为 20（2026-09-18 决策 1）。
MONITOR_KEEP_VIEW_GROWTH=20
MONITOR_KEEP_WANT_GROWTH=2
# 窗口内至少有多少天数据才参与判定（单点数据无法算增长，最小 2）
MONITOR_MIN_DAYS_WITH_DATA=2
# 新商品宽限天数：首次采集距今不足此天数则不判定（默认 14）
MONITOR_PROTECT_DAYS=14
# 单周最多停用多少个商品，0 = 不限（防阈值失效导致批量误杀）
MONITOR_MAX_MUTE_PER_WEEK=0
# 判定任务的 Cron 表达式（默认每周一 09:00）
MONITOR_HEALTH_CRON="0 9 * * 1"

# --- 商品选品：固定席位 + 保量补位 ---
# 每店最多采多少个商品（席位）。不达标的踢出后，用该店「从未采集过」的在售商品补位。
# 补位来源必须能看见第 101+ 名，因此 CANDIDATE_POOL_FACTOR 需 > 1（否则补位无货可补）。
SELECTION_ENABLED=false
# 席位/店
SELECTION_ITEM_LIMIT=100
# 存量门槛：累计浏览量 view_end ≥ 此值（保证有浏览量）
SELECTION_MIN_VIEW_TOTAL=100
# 候选池放大倍数：主页抓取上限 = SELECTION_ITEM_LIMIT × 此值，再从中筛选
SELECTION_CANDIDATE_POOL_FACTOR=3
# 枯竭路线（已定稿 A）：A = 席位置空、不为凑数采烂商品；B = 满 8 周回炉；C = 只回炉「存量高但增长差」
SELECTION_ROUTE=A

# --- 代理池轮换 ---
PROXY_ROTATION_ENABLED=false
# per_task 或 on_failure
PROXY_ROTATION_MODE="per_task"
PROXY_POOL=""
PROXY_ROTATION_RETRY_LIMIT=2
PROXY_BLACKLIST_TTL=300
